<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        android:paddingTop="12dp"
        android:background="#050505" />

    <!-- Empty state - точь-в-точь как сайт: Люми + стартеры -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:background="#050505">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Люми"
            android:textColor="#FAFAFA"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="аниме-подруга и ИИ-программист"
            android:textColor="#71717A"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="sans-serif" />

        <View
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:background="#14FFFFFF" />

        <!-- Стартеры точь-в-точь как на сайте STARTERS: 7 штук с иконками 16dp zinc-600 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStarters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:maxWidth="420dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="19 моделей • без ключей • бесплатно 2026"
            android:textColor="#52525B"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.04" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollDown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="96dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_chevron_down"
        app:tint="#FAFAFA"
        app:fabCustomSize="40dp"
        android:backgroundTint="#1A1A1C"
        app:borderWidth="0dp"
        app:elevation="4dp" />

</FrameLayout>
