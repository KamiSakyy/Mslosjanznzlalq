<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ink" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Люми — подписки на аниме" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Следит за выходом новых серий каждые 10 минут" android:textColor="@color/text_tertiary" android:textSize="12sp" android:layout_marginTop="4dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSubs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCheckNow" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Проверить сейчас"/>
</LinearLayout>
