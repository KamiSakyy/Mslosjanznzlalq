<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="200dp" android:layout_margin="4dp"
    app:cardCornerRadius="12dp" app:cardElevation="0dp">
    <ImageView android:id="@+id/ivImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#80000000" android:textColor="#FFFFFF" android:textSize="11sp" android:padding="6dp" android:maxLines="1" android:ellipsize="end"/>
</androidx.cardview.widget.CardView>
