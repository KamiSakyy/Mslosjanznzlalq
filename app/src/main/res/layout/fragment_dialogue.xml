<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ink">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDialogue" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
        <EditText android:id="@+id/etTopic" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="Тема для бесконечного диалога…" android:textColor="@color/text_primary" android:padding="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStart" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" app:icon="@drawable/ic_send" app:cornerRadius="12dp"/>
    </LinearLayout>
</LinearLayout>
