<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="4dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:gravity="end">

    <!-- Точь-в-точь как сайт: max-w-[86%] rounded-2xl rounded-br-lg bg-[#17171A] border white/[0.07] px-4 py-2.5 text 14.5sp leading 22px -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_user"
        android:layout_marginStart="56dp">

        <ImageView
            android:id="@+id/ivAttachment"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:visibility="gone"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:minWidth="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="#FAFAFA"
            android:textSize="14.5sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif"
            android:text="Сообщение пользователя" />
    </LinearLayout>

    <!-- Meta buttons: copy/edit minimal 12px like site hover -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:alpha="0.9">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_copy"
            app:iconSize="14dp"
            app:iconPadding="0dp"
            app:iconTint="#A1A1AA" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_pencil"
            app:iconSize="14dp"
            app:iconPadding="0dp"
            app:iconTint="#A1A1AA" />
    </LinearLayout>
</LinearLayout>
